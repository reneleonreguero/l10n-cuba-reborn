<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_bank_branch_view_list" model="ir.ui.view">
        <field name="name">res.bank.branch.list</field><field name="model">res.bank.branch</field>
        <field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="bank_id"/><field name="bic"/><field name="municipality_id"/><field name="state_id"/></list></field>
    </record>
    <record id="res_bank_branch_view_form" model="ir.ui.view">
        <field name="name">res.bank.branch.form</field><field name="model">res.bank.branch</field>
        <field name="arch" type="xml"><form string="Sucursal bancaria"><sheet><group><group><field name="bank_id"/><field name="code"/><field name="name"/><field name="bic"/></group><group><field name="state_id"/><field name="municipality_id" domain="[('state_id', '=', state_id)]"/><field name="zip"/><field name="active"/></group></group><group string="Contacto"><field name="street"/><field name="street2"/><field name="phone"/></group></sheet></form></field>
    </record>
    <record id="res_bank_branch_action" model="ir.actions.act_window">
        <field name="name">Sucursales bancarias</field><field name="res_model">res.bank.branch</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="res_bank_branch_menu" name="Sucursales bancarias" parent="contacts.res_partner_menu_config" action="res_bank_branch_action" sequence="23"/>
</odoo>
