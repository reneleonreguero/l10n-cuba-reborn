<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_municipality_view_list" model="ir.ui.view">
        <field name="name">res.municipality.list</field>
        <field name="model">res.municipality</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="state_id"/>
                <field name="country_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="res_municipality_view_form" model="ir.ui.view">
        <field name="name">res.municipality.form</field>
        <field name="model">res.municipality</field>
        <field name="arch" type="xml">
            <form string="Municipio">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="country_id"/>
                        <field name="state_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="res_municipality_action" model="ir.actions.act_window">
        <field name="name">Municipios</field>
        <field name="res_model">res.municipality</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="res_municipality_menu" name="Municipios" parent="contacts.res_partner_menu_config" action="res_municipality_action" sequence="20"/>
</odoo>
