<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_cnae_view_list" model="ir.ui.view">
        <field name="name">res.cnae.list</field>
        <field name="model">res.cnae</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="active" optional="hide"/></list>
        </field>
    </record>
    <record id="res_cnae_view_form" model="ir.ui.view">
        <field name="name">res.cnae.form</field>
        <field name="model">res.cnae</field>
        <field name="arch" type="xml">
            <form string="Actividad economica"><sheet><group><field name="code"/><field name="name"/><field name="active"/></group></sheet></form>
        </field>
    </record>
    <record id="res_cnae_action" model="ir.actions.act_window">
        <field name="name">Actividades economicas (CNAE)</field>
        <field name="res_model">res.cnae</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="res_cnae_menu" name="Actividades economicas (CNAE)" parent="contacts.res_partner_menu_config" action="res_cnae_action" sequence="21"/>
</odoo>
