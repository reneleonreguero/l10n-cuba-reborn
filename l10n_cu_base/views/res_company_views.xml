<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_view_form_l10n_cu" model="ir.ui.view">
        <field name="name">res.company.form.l10n.cu</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="company_registry" position="after">
                <field name="l10n_cu_entity_type" invisible="country_code != 'CU'"/>
                <field name="l10n_cu_duine_id" invisible="country_code != 'CU'"/>
                <field name="l10n_cu_reeup" invisible="country_code != 'CU'"/>
                <field name="l10n_cu_registry_number" invisible="country_code != 'CU'"/>
                <field name="l10n_cu_rcc_licence" invisible="country_code != 'CU'"/>
            </field>
        </field>
    </record>
</odoo>
