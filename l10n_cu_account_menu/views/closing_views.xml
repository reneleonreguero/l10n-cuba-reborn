<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_cu_closing_wizard_form" model="ir.ui.view">
        <field name="name">l10n.cu.closing.wizard.form</field>
        <field name="model">l10n_cu_closing_wizard</field>
        <field name="arch" type="xml">
            <form string="Cierre anual">
                <group>
                    <field name="company_id"/>
                    <field name="date_to"/>
                    <field name="journal_id"/>
                    <field name="post_move"/>
                    <field name="lock_period"/>
                    <field name="move_id" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generate"
                        string="Generar cierre"
                        type="object"
                        class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_cu_closing" model="ir.actions.act_window">
        <field name="name">Cierre anual</field>
        <field name="res_model">l10n_cu_closing_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cu_closing"
        name="Cierre anual"
        parent="menu_cu_accounting_root"
        action="action_l10n_cu_closing"
        groups="account.group_account_user"
        sequence="40"/>
</odoo>
