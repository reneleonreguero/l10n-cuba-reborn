<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <div class="page">
                <h2>Nómina <span t-field="o.batch_id.name"/></h2>
                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Trabajador:</strong>
                        <span t-field="o.employee_id.name"/>
                    </div>
                    <div class="col-6">
                        <strong>Período:</strong>
                        <span t-field="o.batch_id.date_from"/> - <span t-field="o.batch_id.date_to"/>
                    </div>
                </div>
                <table class="table table-borderless">
                    <tr>
                        <td>Salario devengado</td>
                        <td class="text-end"><span t-field="o.wage"/></td>
                    </tr>
                    <tr>
                        <td>Provisión de vacaciones (<span t-field="o.vacation_rate"/>%)</td>
                        <td class="text-end"><span t-field="o.vacation_amount"/></td>
                    </tr>
                    <tr>
                        <td>Seguridad Social trabajador (<span t-field="o.ss_worker_rate"/>%)</td>
                        <td class="text-end">(<span t-field="o.ss_worker"/>)</td>
                    </tr>
                    <tr>
                        <td>Otras retenciones</td>
                        <td class="text-end">(<span t-field="o.other_deductions"/>)</td>
                    </tr>
                    <tr>
                        <td><strong>Neto a pagar</strong></td>
                        <td class="text-end"><strong><span t-field="o.net"/></strong></td>
                    </tr>
                </table>
                <p class="text-muted">
                    Aporte del empleador a la Seguridad Social
                    (<span t-field="o.ss_employer_rate"/>%):
                    <span t-field="o.ss_employer"/>.
                </p>
            </div>
        </t>
    </template>

    <template id="report_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_cu_payroll.report_payslip_document" t-lang="o.company_id.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="report_payslip_action" model="ir.actions.report">
        <field name="name">Nómina</field>
        <field name="model">l10n_cu_payroll.slip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_cu_payroll.report_payslip</field>
        <field name="binding_model_id" ref="model_l10n_cu_payroll_slip"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
